# Copy this file to `.env` and fill in the values.
# Prisma's CLI only reads `.env`, so keep DATABASE_URL there.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dripfit?schema=public"

# --- Auth (NextAuth + Google) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Admin access ---
# Comma-separated emails allowed to open /dashboard and use the admin APIs.
ADMIN_EMAILS="you@example.com"

# --- Image uploads (Cloudinary) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Order confirmation emails (Gmail) ---
# Use a Google "App password", not your normal password.
EMAIL_USER=""
EMAIL_APP_PASSWORD=""

# --- Optional ---
# Base URL the browser uses to call the API. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
